# Generate a long random value before deployment. Use `openssl rand -hex 32`.
#
# This single value is used in three places, so you only manage one password:
#   1. written into the generated config.yaml as `secret:`
#   2. presented by the manager when it calls the Mihomo controller
#   3. required by the Studio panel as the `X-Admin-Token` header
#
# Replace this placeholder before starting. Compose refuses known placeholders and
# secrets shorter than 32 characters.
MIHOMO_SECRET=replace-with-a-long-random-secret

# Pin the official MetaCubeX image to a tested tag or digest before production use.
MIHOMO_IMAGE=metacubex/mihomo:v1.19.32

# ---------------------------------------------------------------------------
# Bind addresses. Studio defaults to LAN-accessible; the proxy listener and
# Mihomo controller remain loopback-only. Read docs/security.md before changing these.
# ---------------------------------------------------------------------------

# Proxy listener. Set to the host LAN IP only when terminal devices must connect
# through this instance. 0.0.0.0 exposes the proxy on every interface.
MIHOMO_BIND_IP=127.0.0.1

# Studio control UI and API. LAN-accessible by default; requires MIHOMO_SECRET.
# Set to 127.0.0.1 to restrict access to this host, or a specific host interface IP
# to bind only that interface. Restrict access further with the host firewall.
STUDIO_BIND_IP=0.0.0.0

# Mihomo controller. Protected only by MIHOMO_SECRET, and a holder of that secret
# can rewrite live routing while bypassing candidate validation and audit.
# Set to the LAN IP (not 0.0.0.0) only for a trusted diagnostic dashboard.
CONTROLLER_BIND_IP=127.0.0.1

# Optional: module proxy and base images for networks that cannot reach
# proxy.golang.org or Docker Hub. See compose.podman.yaml.
# GOPROXY=https://proxy.golang.org,direct
# GO_IMAGE=golang:1.23-alpine
# RUNTIME_IMAGE=alpine:3.21
# ALPINE_IMAGE=alpine:3.21
