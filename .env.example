# Generate a long random value before deployment. This secret protects Mihomo's controller API.
MIHOMO_SECRET=replace-with-a-long-random-secret
# Pin the official MetaCubeX image to a tested tag or digest before production use.
MIHOMO_IMAGE=metacubex/mihomo:v1.19.32

# Keep loopback for local-only use. Set this to the host LAN IP only when terminal devices should connect.
MIHOMO_BIND_IP=127.0.0.1
