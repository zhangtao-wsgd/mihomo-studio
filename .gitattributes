# Normalize line endings so the repository behaves identically on Windows and Linux.
# Without this, Git's autocrlf setting rewrites shell scripts to CRLF on Windows
# checkouts, and CRLF breaks a `#!/usr/bin/env bash` shebang inside a Linux container
# with "bad interpreter: No such file or directory".

* text=auto eol=lf

# Shell scripts and container entrypoints must stay LF.
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
Dockerfile     text eol=lf
.dockerignore  text eol=lf
Makefile       text eol=lf

# Go and docs are safest with LF as well.
*.go       text eol=lf
*.sql      text eol=lf
*.md       text eol=lf
go.mod     text eol=lf
go.sum     text eol=lf

# Windows-only command scripts keep CRLF so cmd.exe parses them correctly.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets are never touched.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
